{
  "name": "WaFox",
  "description": "WhatsApp client for Firefox OS (talks to a self-hosted bridge)",
  "launch_path": "/index.html",
  "type": "web",
  "version": "1.0.1",
  "default_locale": "en",
  "developer": { "name": "WaFox" },
  "icons": {
    "60": "/60.png",
    "128": "/128.png"
  },
  "permissions": {
    "desktop-notification": {
      "description": "Show notifications for new messages"
    }
  }
}
